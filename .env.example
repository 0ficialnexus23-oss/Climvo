# ---------------------------------------------------------------------------
# Climvo — plantilla de variables de entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ---------------------------------------------------------------------------

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://usuario:password@localhost:5432/climvo?schema=public"

# Autenticación (Auth.js)
# Genera un valor aleatorio largo, por ejemplo: openssl rand -base64 32
AUTH_SECRET="reemplaza-por-un-secreto-aleatorio-de-32-bytes"
AUTH_URL="http://localhost:3000"

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Almacenamiento de archivos (evidencia, reportes)
# En desarrollo se usa almacenamiento local. En producción, S3-compatible.
STORAGE_DRIVER="local"
# STORAGE_DRIVER="s3"
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Email transaccional (recuperación de contraseña) — opcional en el MVP
# RESEND_API_KEY=""

# WhatsApp Cloud API — NO se usa en el MVP (fase 2). Se deja documentado.
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_VERIFY_TOKEN=""
