# ---------------------------------------------------------------------------
# Elielsito AI — plantilla de variables de entorno
# Copia este archivo a .env y completa SOLO lo que vayas a usar.
# El archivo .env NUNCA se sube al repositorio.
# ---------------------------------------------------------------------------

# Carpeta de datos (memoria, auditoría). Por defecto: ~/.elielsito
# ELELSITO_DATA_DIR=/home/tu-usuario/.elielsito

# ---------------------------------------------------------------------------
# Modelo de IA
# ---------------------------------------------------------------------------
# Proveedor: mock | openai | anthropic | gemini | ollama
#   mock      -> no usa internet ni claves. Sirve para probar la arquitectura.
#   openai    -> API de OpenAI (de pago).
#   anthropic -> API de Anthropic/Claude (de pago).
#   gemini    -> API de Google Gemini (tiene nivel gratuito limitado).
#   ollama    -> servidor LOCAL compatible con OpenAI. Gratis, sin internet.
ELELSITO_MODEL_PROVIDER=mock
ELELSITO_MODEL_NAME=mock-1

# Para proveedores locales o compatibles con OpenAI (Ollama, LM Studio, llama.cpp):
# ELELSITO_MODEL_BASE_URL=http://localhost:11434/v1

# Claves de API (solo la del proveedor que uses). NUNCA las subas al repositorio.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------
# Permite herramientas de ejecución de comandos (por defecto desactivado).
ELELSITO_ALLOW_SHELL=0

# Raíces permitidas para las herramientas de archivos, separadas por ":"
# (Linux/macOS) o ";" (Windows). Si está vacío, solo se permite la carpeta de datos.
# ELELSITO_ALLOWED_ROOTS=/home/tu-usuario/proyectos
